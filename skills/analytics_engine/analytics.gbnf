root ::= "{" ws "\"template\"" ws ":" ws template_name ws "," ws "\"params\"" ws ":" ws params ws "}"

template_name ::= "\"sales_by_period\"" | "\"top_n_products\"" | "\"margin_by_category\"" | "\"stock_turnover\""

params ::= "{" ws param_list ws "}"
param_list ::= param (ws "," ws param)*
param ::= param_name ws ":" ws param_value

param_name ::= "\"period\"" | "\"start_date\"" | "\"end_date\"" | "\"n\"" | "\"metric\"" | "\"days\""

param_value ::= string_val | int_val

string_val ::= "\"" period_enum "\"" | "\"" metric_enum "\"" | "\"" date_str "\""
period_enum ::= "\"hour\"" | "\"day\"" | "\"week\"" | "\"month\"" | "\"all\""
metric_enum ::= "\"revenue\"" | "\"quantity\""
date_str ::= [0-9][0-9][0-9][0-9] "-" [0-9][0-9] "-" [0-9][0-9]

int_val ::= "-"? [0-9]+

ws ::= [ \t\n]*
